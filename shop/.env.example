# ---------------------------------------------------------------
#  فندق | تنظیمات محیطی سایت فروش
#  این فایل را به .env کپی کنید و مقادیر را تغییر دهید
# ---------------------------------------------------------------

# مسیر دیتابیس (SQLite). نسبت به پوشه prisma حساب می‌شود.
DATABASE_URL="file:../data/fandogh.db"

# کلید امضای کوکی‌ها و توکن‌ها — حتماً عوض شود (openssl rand -hex 32)
AUTH_SECRET="change-me-please-openssl-rand-hex-32"

# آدرس عمومی سایت (برای لینک‌ها و QR)
APP_URL="http://localhost:3000"

# حساب مدیر که در زمان seed ساخته می‌شود
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"

# پورت داخلی برنامه (داخل کانتینر)
PORT=3000

# پورتی که روی سرور باز می‌شود
APP_PORT=3000

# آدرسی که پورت روی آن منتشر می‌شود:
#   0.0.0.0   = از بیرون سرور با http://IP:APP_PORT در دسترس است (پیش‌فرض)
#   127.0.0.1 = فقط از داخل سرور؛ این را وقتی بگذارید که Nginx جلوی برنامه است
BIND_ADDR=0.0.0.0

# مسیر ذخیره رسیدهای پرداخت
UPLOAD_DIR="./data/uploads"
